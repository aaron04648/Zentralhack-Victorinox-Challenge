FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Bilderkennung -----------------------------------------------------------
# Anbieter: clef (Standard, wenn OPENROUTER_API_KEY gesetzt) | openai (Azure oder OpenAI)
# VISION_ANBIETER=clef

# Cloudflare Clef über OpenRouter (backend/app/clef.py, tools/clef_client.py)
# Key: https://openrouter.ai/settings/keys
# Clef decision models (NOT listed in the OpenRouter catalogue, and NOT usable
# via /chat/completions - use POST https://openrouter.ai/api/alpha/decisions):
#   cloudflare/clef-flash   (9B, ~$0.00003/decision - recommended default)
#   cloudflare/clef         (27B, ~$0.00019/decision - escalation only)
OPENROUTER_API_KEY=
# CLEF_MODEL=cloudflare/clef-flash
# Wahrscheinlichkeit, ab der ein Werkzeug als erkannt gilt
# CLEF_SCHWELLE=0.5

# Azure OpenAI: Deployment eines bildfähigen Modells (z. B. gpt-4o)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI direkt (wird nur genutzt, wenn AZURE_OPENAI_* leer ist)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anzahl Referenzbilder im Prompt (Few-Shot, nur openai), 0 = keine
VISION_FEWSHOT=4
# Nach dem Fine-Tuning: Deployment-/Modellname des trainierten Modells (ersetzt die Referenzbilder)
VISION_FT_DEPLOYMENT=

# --- Fine-Tuning (training/finetune.py) ------------------------------------
# FT_BASISMODELL=gpt-4o-2024-08-06
# FT_EPOCHEN=3

# --- TypeSafe Jev (optional, nur mit VISION_ANBIETER=openai sinnvoll) -------
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
