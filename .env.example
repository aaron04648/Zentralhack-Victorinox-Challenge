FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Bilderkennung (eins von beiden) ---------------------------------------
# Azure OpenAI: Deployment eines bildfähigen Modells (z. B. gpt-4o)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21

# OpenAI direkt (wird nur genutzt, wenn AZURE_OPENAI_* leer ist)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anzahl Referenzbilder im Prompt (Few-Shot), 0 = keine
VISION_FEWSHOT=4
# Nach dem Fine-Tuning: Deployment-/Modellname des trainierten Modells (ersetzt die Referenzbilder)
VISION_FT_DEPLOYMENT=

# --- Fine-Tuning (training/finetune.py) ------------------------------------
# FT_BASISMODELL=gpt-4o-2024-08-06
# FT_EPOCHEN=3

# --- TypeSafe Jev (optional) -----------------------------------------------
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
